# LocalClip Configuration

# AI Provider: gemini, openai, anthropic, groq, xai, openrouter, ollama, custom
LC_PROVIDER=gemini

# Model: e.g. gemini-1.5-flash, gpt-4o-mini, llama-3.3-70b-versatile, etc.
LC_MODEL=gemini-1.5-flash

# API Key for chosen provider (leave empty for ollama)
LC_KEY=your_api_key_here

# Whisper model size for speech-to-text (tiny, base, small, medium, large-v3)
LC_WHISPER=small

# Port (defaults to 8765)
LC_PORT=8765

# Upload limit in MB (defaults to 500)
LC_MAX_MB=500
