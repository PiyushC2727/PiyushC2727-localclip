# ==============================================================================
# LocalClip Configuration
# ==============================================================================

# AI Provider options: gemini, openai, groq, deepseek, anthropic, xai, openrouter, ollama, custom
LC_PROVIDER=gemini

# Model ID (comma-separated for automatic fallback chain):
# - Gemini:   gemini-1.5-flash,gemini-2.0-flash
# - Groq:     llama-3.3-70b-versatile,llama-3.1-8b-instant
# - OpenAI:   gpt-4o-mini,gpt-4o
# - DeepSeek: deepseek-chat
# - Ollama:   llama3.2,mistral
LC_MODEL=gemini-1.5-flash

# API Key for your chosen provider (leave empty for local ollama)
LC_KEY=your_api_key_here

# Faster-Whisper Model Size: tiny, base, small, medium, large-v3
# "small" is the sweet spot of speed and accuracy. Use "base" or "tiny" if low on RAM.
LC_WHISPER=small

# Device for Whisper: auto-detected if empty, or set "cuda" or "cpu"
LC_DEVICE=

# Default Video Framing:
# - "crop": Standard 9:16 vertical center crop
# - "blur": 9:16 blurred background with centered video (no speaker cutoff)
LC_FRAMING=crop

# Default Subtitle Animation Style:
# - "karaoke": Word-by-word active bounce highlight (Alex Hormozi style)
# - "classic": Crisp bold subtitles without animation
# - "none": No burned-in subtitles
LC_CAPTION_STYLE=karaoke

# Caption Accent Highlight Color: gold, cyan, green, magenta, white
LC_CAPTION_COLOR=gold

# Web Server Port (defaults to 8765)
LC_PORT=8765

# Maximum Video Upload Size in Megabytes (defaults to 500 MB)
LC_MAX_MB=500

# Optional: Netscape-format cookies string for yt-dlp to bypass YouTube restrictions
# LC_COOKIES=
